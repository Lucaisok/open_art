# Copy to .env and fill in. Never commit .env. On the VPS: chmod 600 .env
#
# Database (the Postgres container creates this user and database on its first start)
POSTGRES_USER=openart
POSTGRES_DB=openart
# Generate with: openssl rand -hex 32   (hex only, so it is safe inside the database URL)
POSTGRES_PASSWORD=

# Login cookie: true on the VPS (HTTPS). false locally, where the site is plain http://localhost
COOKIE_SECURE=true

# The site's own address(es): requests that change data from anywhere else are refused (CSRF)
# VPS:     https://open-art.lucadev.org
# Locally: http://localhost:3040,http://127.0.0.1:3040
ALLOWED_ORIGINS=https://open-art.lucadev.org
